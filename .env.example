# PostgreSQL 連線字串（Neon：Connection pooling 的網址）
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# 執行資料庫遷移用的直連網址（Neon：未經 pooler 的網址；本機可與 DATABASE_URL 相同）
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# 排程同步的密鑰：任意長亂碼，Vercel Cron 會自動帶上
CRON_SECRET="請改成至少 32 字的亂碼"
# 選填：要同步的 CPBL 賽事類型（A 例行賽、E 季後挑戰賽、C 總冠軍賽…），預設 A,E,C
# SYNC_KIND_CODES="A,E,C"
